<Window x:Class="TaxiPark.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отметка о ТО" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="TbCar" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TextBlock Text="Описание выполненных работ"/>
        <TextBox x:Name="TbDescription" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,8"/>
        <TextBlock Text="Стоимость, руб."/>
        <TextBox x:Name="TbCost" Margin="0,2,0,12" Text="0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
