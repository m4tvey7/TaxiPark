<Window x:Class="TaxiPark.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Таксопарк - вход" Height="320" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="30" VerticalAlignment="Center">
        <TextBlock Text="Учёт автомобилей в таксопарке" FontSize="18" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,20"/>
        <TextBlock Text="Логин"/>
        <TextBox x:Name="TbLogin" Margin="0,2,0,10" Padding="4"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PbPassword" Margin="0,2,0,15" Padding="4"/>
        <Button Content="Войти" IsDefault="True" Click="Login_Click"/>
    </StackPanel>
</Window>
