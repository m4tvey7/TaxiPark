<Window x:Class="TaxiPark.CarEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автомобиль" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Марка (выберите или введите новую)"/>
        <ComboBox x:Name="CbBrand" IsEditable="True" Margin="0,2,0,8"/>
        <TextBlock Text="Модель (выберите или введите новую)"/>
        <ComboBox x:Name="CbModel" IsEditable="True" Margin="0,2,0,8"/>
        <TextBlock Text="Год выпуска"/><TextBox x:Name="TbYear" Margin="0,2,0,8"/>
        <TextBlock Text="Госномер"/><TextBox x:Name="TbPlate" Margin="0,2,0,8"/>
        <TextBlock Text="Цвет"/><TextBox x:Name="TbColor" Margin="0,2,0,8"/>
        <TextBlock Text="Пробег, км"/><TextBox x:Name="TbMileage" Margin="0,2,0,8"/>
        <TextBlock Text="Требуемая категория прав"/>
        <ComboBox x:Name="CbCategory" Margin="0,2,0,8" DisplayMemberPath="code" SelectedValuePath="category_id"/>
        <TextBlock Text="Статус"/>
        <ComboBox x:Name="CbStatus" Margin="0,2,0,12" DisplayMemberPath="name" SelectedValuePath="status_id"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" IsDefault="True" Click="Save_Click"/>
            <Button Content="Отмена" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
